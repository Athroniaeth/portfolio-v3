# Single origin: nginx serves the prerendered pages, proxies /api to Litestar and /op
# to the OpenPanel instance. The browser only ever sees one host, so no CORS, no API
# URL baked into the bundle, and no second TLS handshake for analytics.
#
# A template, not a plain conf: the nginx entrypoint runs envsubst over
# /etc/nginx/templates at startup to inject ${API_KEY} and ${OPENPANEL_API_URL}.
# NGINX_ENVSUBST_FILTER limits the substitution to those names, so nginx's own
# $uri/$host survive untouched.
# Keep the protocol seen by the *browser*. Traefik terminates TLS and talks to this
# container in plain HTTP, so $scheme is "http" here: forwarding it would tell the API
# the visitor is not on HTTPS, which breaks Secure cookies and absolute redirects.
# Falls back to $scheme when no proxy sits in front (local `docker compose`).
map $http_x_forwarded_proto $forwarded_proto {
    ""      $scheme;
    default $http_x_forwarded_proto;
}

# Pass the chain through untouched when a proxy already set it. The usual
# $proxy_add_x_forwarded_for would append $remote_addr, which real_ip has just
# rewritten to the client address — listing it twice for no reason.
map $http_x_forwarded_for $forwarded_for {
    ""      $remote_addr;
    default $http_x_forwarded_for;
}

# Which image format this client takes. Every browser that supports AVIF advertises
# it in Accept on image requests; the ones that do not simply get no suffix here and
# fall through to the WebP.
#
# The lookahead is the whole point. A bare "~image/avif" is a substring match, so
# `Accept: image/avif;q=0` — which is a client saying explicitly that it does *not*
# want AVIF — would have been served one.
map $http_accept $avif_suffix {
    default                                          "";
    "~image/avif(?!\s*;\s*q=0(\.0+)?\s*(,|$))"       ".avif";
}

# HSTS only over HTTPS, which is what the RFC asks and what keeps a plain-HTTP
# development run from poisoning a browser for a year. nginx skips an add_header whose
# value is empty, so the default branch simply emits nothing.
#
# No `preload`: that one is a one-way door, submitted to a list browsers ship, and it
# is not this site's to spend on every future subdomain.
map $forwarded_proto $hsts_header {
    default "";
    https   "max-age=31536000; includeSubDomains";
}

# The analytics endpoint is the only thing on this origin that forwards a body to a
# third party, so it gets its own budget. One page view is one event; sixty a minute
# is far above any honest visitor and far below what makes a useful flood.
limit_req_zone $binary_remote_addr zone=analytics:1m rate=60r/m;

server {
    # 8080 rather than 80: the base image runs unprivileged.
    listen 8080;

    # Recover the real client address from the proxy in front, so $remote_addr — and
    # therefore the access log and X-Real-IP — stop showing Traefik's internal IP.
    # Trust is limited to private ranges: X-Forwarded-For is client-controlled and
    # must never be believed when it comes straight from the internet.
    set_real_ip_from 10.0.0.0/8;
    set_real_ip_from 172.16.0.0/12;
    set_real_ip_from 192.168.0.0/16;
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;
    server_name _;

    # Answer redirects with a relative Location. Building an absolute one is the
    # default, and behind Traefik nginx would build it from what *it* sees — plain
    # HTTP on port 8080 — so /about would send the visitor to
    # http://host:8080/#about. A relative Location is resolved by the browser against
    # the URL it actually asked for, which is the https one.
    absolute_redirect off;

    root /usr/share/nginx/html;

    # Serve the .gz written at build time instead of compressing on every request.
    # `gzip on` stays as the fallback for anything with no precompressed twin, but at
    # level 1 and only for text — see frontend/scripts/compress.mjs.
    gzip_static on;
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    # Vite hashes the name of every asset, so the content behind one of these URLs can
    # never change.
    location /assets/ {
        include /etc/nginx/security-headers.conf;

        # One header only: adding `expires` would emit a second, duplicate one.
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        access_log off;
        try_files $uri =404;
    }

    # Pick the image format here rather than in the markup.
    #
    # The page used to ship a <picture> with one <source> per format, which is three
    # elements per image and twenty-one across the page, all of them to answer a
    # question the server can answer on its own. The markup now names the WebP, and
    # this block hands over the AVIF when the browser says in Accept that it takes
    # one. Same bytes on the wire, one element per image instead of three.
    #
    # `Vary: Accept` is not optional: without it a shared cache would be free to
    # serve the AVIF it stored for one visitor to a browser that cannot decode it.
    #
    # The Content-Type follows the file try_files actually resolved, not the .webp in
    # the request, because try_files rewrites the internal URI before the type is
    # looked up.
    location ~ ^/images/(?<image_path>.+)\.webp$ {
        include /etc/nginx/security-headers.conf;

        add_header Cache-Control "public, max-age=604800" always;
        add_header Vary "Accept" always;
        access_log off;
        try_files /images/$image_path$avif_suffix /images/$image_path.webp =404;
    }

    # Fonts and images are not hashed — they are written by `just fonts` and
    # `just images` and referenced by a stable name — so they cannot claim to be
    # immutable. A week is long enough that a repeat visitor re-fetches nothing, and
    # short enough that replacing an image is visible without renaming it.
    location ~ ^/(fonts|images|icons|vendor)/ {
        include /etc/nginx/security-headers.conf;

        add_header Cache-Control "public, max-age=604800" always;
        access_log off;
        try_files $uri =404;
    }

    location /api/ {
        include /etc/nginx/security-headers.conf;

        # The API key is added here, server-side, so it never reaches the browser:
        # the bundle holds no secret. proxy_set_header also overwrites any header a
        # client sent, so this value is the only one the API ever sees from us.
        proxy_set_header X-API-Key "${API_KEY}";

        # Resolved per request, through a variable, rather than once at startup. With
        # a literal upstream nginx refuses to start at all when `api` does not resolve
        # yet, which made a site of static files unable to serve a byte because a
        # Python process it never calls was not up. Now it starts, serves every page,
        # and answers 502 here alone until the API arrives.
        resolver 127.0.0.11 valid=30s ipv6=off;
        set $api "http://api:8000";
        proxy_pass $api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
    }

    # Analytics, proxied first-party, on exactly one path.
    #
    # The page calls /op/track on its own origin and this block forwards it to the
    # OpenPanel instance, so the browser never opens a second connection: no extra DNS
    # lookup, TCP handshake or TLS negotiation for a few hundred bytes of telemetry,
    # and the CSP needs no third-party origin.
    #
    # `location = /op/track` rather than a `/op/` prefix, and POST only. The prefix
    # form forwarded any path and any method, with the default one megabyte body, to
    # a service that is not ours to expose — an open relay into the analytics instance
    # with this host's address in front of it. The vendored op1.js calls exactly one
    # endpoint, so exactly one is what is open.
    #
    # `rewrite` strips the prefix, not a trailing slash on proxy_pass. The usual
    # `proxy_pass https://host/;` idiom does not apply once the upstream is a variable:
    # nginx then treats a URI in the directive as a *replacement* for the request URI
    # rather than a prefix, so /op/track would arrive as / and the instance would
    # answer "Route POST:/ not found".
    #
    # Origin and User-Agent are passed through untouched on purpose. The instance
    # checks Origin against the project's allowed domains — rewriting it would make
    # every event 401 — and reads User-Agent for device attribution.
    location = /op/track {
        include /etc/nginx/security-headers.conf;

        limit_except POST {
            deny all;
        }
        # A page view is one event of a few hundred bytes. Both numbers are far above
        # any honest visitor and far below what makes a useful flood.
        client_max_body_size 32k;
        limit_req zone=analytics burst=10 nodelay;

        # The upstream is an external name, so it has to be resolved at request time.
        # Without a resolver nginx resolves it once at startup and keeps the address
        # forever, which breaks the day the instance moves.
        resolver 127.0.0.11 1.1.1.1 valid=300s ipv6=off;
        set $openpanel "${OPENPANEL_API_URL}";

        rewrite ^/op/(.*)$ /$1 break;
        proxy_pass $openpanel;
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;

        # Telemetry must never hold a page open; the visitor's browser has already
        # moved on.
        proxy_connect_timeout 3s;
        proxy_read_timeout 5s;
        access_log off;
    }

    # The OpenAPI docs, served by Litestar. Off by default in production.
    location /schema {
        include /etc/nginx/security-headers.conf;

        resolver 127.0.0.11 valid=30s ipv6=off;
        set $schema_api "http://api:8000";
        proxy_pass $schema_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
    }

    # Asked for by browsers on their own. The site declares an SVG icon, so without
    # this the request falls through to the page handler and answers HTML with a 200
    # where an icon is expected.
    location = /favicon.ico {
        return 204;
        access_log off;
    }

    # The site used to be four pages, and those URLs are in search results, in the
    # LinkedIn profile and in anyone's bookmarks. Each of them is now a section of the
    # single page, so they redirect to their anchor rather than 404.
    #
    # Quoted because nginx starts a comment at an unquoted `#`, which would turn the
    # target into a bare `/` and silently send every one of these to the top of the
    # page. 301 rather than 302: this is permanent, and a crawler should replace the
    # old URL in its index rather than keep checking it.
    location ~ ^/(en/)?(about|projects|contact)/?$ {
        return 301 "/$1#$2";
    }

    # Every route is a file on disk: / is index.html and /en/ is en/index.html. There
    # is no SPA fallback because there is no SPA — a URL that matches nothing is a 404,
    # and says so, instead of returning the homepage with a 200.
    #
    # `$uri/index.html` also catches /en without its trailing slash. That serves the
    # page at a second URL, which the <link rel="canonical"> in every document resolves
    # for crawlers; every link the site generates uses the slash.
    #
    # `no-cache` on the HTML, else a browser would keep the old hashed asset names and
    # never see a deployment.
    # English lives under /en/ and French at the root, both as real files on disk.
    # This block exists only to point error_page at the English 404 — otherwise an
    # English visitor who mistypes a URL would land on a French error page.
    location /en/ {
        include /etc/nginx/security-headers.conf;

        add_header Cache-Control "no-cache" always;
        error_page 404 /en/404.html;
        try_files $uri $uri/index.html =404;
    }

    location / {
        include /etc/nginx/security-headers.conf;

        add_header Cache-Control "no-cache" always;
        try_files $uri $uri/index.html =404;
    }

    error_page 404 /404.html;

    # Internal so the prerendered 404 documents cannot be reached directly at
    # /404.html with a 200.
    location = /404.html {
        include /etc/nginx/security-headers.conf;
        internal;
    }

    location = /en/404.html {
        include /etc/nginx/security-headers.conf;
        internal;
    }
}
