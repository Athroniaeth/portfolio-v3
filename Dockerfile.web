# Frontend image: Vite bundle served by nginx. No Python — the TypeScript types are
# derived from openapi.json, versioned at the repo root.
FROM node:22-slim AS builder

WORKDIR /app
# Manifest and lockfile alone first, to keep the install cached.
COPY frontend/package.json frontend/pnpm-lock.yaml ./frontend/
RUN corepack enable && pnpm -C frontend install --frozen-lockfile

COPY openapi.json ./openapi.json
# deploy/ comes along because the prerender writes the CSP hash of its inline theme
# script into deploy/csp-script-hash.conf. Generating it here and copying the result
# into the runtime stage is what makes the header correct by construction: a stale
# committed hash would block the script and leave every visitor on the wrong theme.
COPY deploy ./deploy
COPY frontend ./frontend
# `build` chains four steps: the client bundle, the server bundle, the prerender that
# writes one HTML document per route, and the gzip pass. See frontend/package.json.
RUN pnpm -C frontend generate-types && pnpm -C frontend build

# Unprivileged nginx image: runs as the `nginx` user and listens on 8080.
FROM nginxinc/nginx-unprivileged:1.29-alpine AS runtime

# Templates are rendered by the entrypoint at startup; the filter keeps envsubst away
# from nginx's own variables, so only these two are replaced.
ENV NGINX_ENVSUBST_FILTER="^(API_KEY|OPENPANEL_API_URL)$"
COPY deploy/default.conf.template /etc/nginx/templates/default.conf.template
# Outside templates/ on purpose: it holds no variable to substitute, and the server
# config includes it by absolute path.
COPY deploy/security-headers.conf /etc/nginx/security-headers.conf
# From the builder, not the build context: this file is generated by the prerender a
# few lines above, so what lands here always matches the script actually in the HTML.
#
# Into conf.d, not templates/: it defines a `map`, which only exists at http level, and
# conf.d is what nginx includes there. The 00- prefix is cosmetic — nginx parses the
# whole config before serving, so the map is visible wherever it is declared.
COPY --from=builder /app/deploy/csp-script-hash.conf /etc/nginx/conf.d/00-csp-script-hash.conf
COPY --from=builder /app/frontend/dist /usr/share/nginx/html

EXPOSE 8080
